# Aether Transfer — environment variable NAMES only.
# Copy this file. Do not commit real values. Never put secrets in git or checkpoints.

# Production application runtime connection.
# MUST authenticate as aether_app LOGIN (SQL-created), NOT the table/schema owner
# and NOT a Neon Console-created role (those inherit neon_superuser).
# Must be a different URL than AETHER_DATABASE_OWNER_URL.
# Production without this URL fails closed (PGLite is never used).
# Password is supplied out of band; never committed.
DATABASE_URL=

# Privileged migration / schema-owner / hotel-provisioner connection.
# Used ONLY by scripts/migrate.mjs and scripts/provision-hotel.mjs.
# Never a runtime fallback. Never used by guest or /ops.
# Production owner operations fail if this is unset. DATABASE_URL is never used to migrate or provision.
AETHER_DATABASE_OWNER_URL=

# Centralized transactional email delivery (server-only).
# RESEND_API_KEY is supplied out of band; never commit the real value.
# RESEND_FROM_EMAIL must be a verified Resend sending address/domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Optional public origin used when no request Origin header is available.
PUBLIC_APP_URL=https://scan-book-go.vercel.app

# Optional preview operator bootstrap (not a recovered production password).
# Production refuses the known preview pair desk / desk-pass.
AETHER_OPS_LOGIN=
AETHER_OPS_PASSWORD=

# Restore target for scripts/restore_aether.sh
# preview  = local/PGLite allowed, labelled as a development substitute
# production = fail closed unless DATABASE_URL and AETHER_DATABASE_OWNER_URL are set
AETHER_RESTORE_TARGET=preview

# Domain A (SBG SaaS subscriptions) commercial activation. Fail-closed.
# off (default) = no SaaS Checkout or billing portal even if Stripe keys exist.
# test = Stripe TEST MODE only. live is reserved for CP31 — do not set live before then.
SBG_SAAS_COMMERCE=off

# CP26C test isolation only. Comma-separated hotel UUIDs.
# Consulted only when SBG_SAAS_COMMERCE=test. empty = nobody authorised.
# Not a live customer authorization mechanism. Ignored when mode=live.
# Never put a Production hotel UUID in git.
SBG_SAAS_TEST_HOTEL_IDS=

# CP26 FINALISATION organisation test isolation. Comma-separated organisation UUIDs.
# Consulted only when SBG_SAAS_COMMERCE=test. empty = nobody authorised.
# Not a live customer authorization mechanism. Ignored when mode=live.
SBG_SAAS_TEST_ORGANISATION_IDS=

STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=
STRIPE_BASIC_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_PREMIUM_PRICE_ID=
